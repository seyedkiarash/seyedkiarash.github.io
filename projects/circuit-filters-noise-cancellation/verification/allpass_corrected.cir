* corrected delay stage (R1=R2=1.125k, R3=1k)
XU1 0 N001 N002 N003 N004 opamp
XU2 0 N005 N002 N003 Vo opamp
C1 N001 N006 10n
C2 N004 N006 10n
R1 N006 N007 1.125k
R2 N004 N001 1.125k
VV1 N002 0 30 
VV2 N003 0 -30 
R3 N005 N004 1k
R41 N005 N007 4k
R42 Vo N005 4k
VVs N007 0 AC 1
.include opamp.lib
.ac dec 200 10 100k
.control
run
let gd = -1*deriv(cph(v(Vo)))/(2*pi)
wrdata allpass_corrected.txt vdb(Vo) cph(v(Vo)) gd
.endc
.end
